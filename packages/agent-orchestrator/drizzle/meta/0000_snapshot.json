          "name": "intents_customer_id_format",
          "value": "\"agent\".\"intents\".\"customer_id\" ~ '^[A-Za-z0-9_-]{1,128}$'"
        },
        "intents_text_bounded": {
          "name": "intents_text_bounded",
          "value": "length(btrim(\"agent\".\"intents\".\"intent_text\")) BETWEEN 1 AND 10000"
        },
        "intents_executing_requires_event_id": {
          "name": "intents_executing_requires_event_id",
          "value": "\"agent\".\"intents\".\"status\" NOT IN ('executing','completed','failed','needs_review') OR \"agent\".\"intents\".\"durable_ledger_event_id\" IS NOT NULL"
        }
